# Modèle de .env — préférer scripts/generate-env.sh qui remplit les secrets.
# Valeurs "à plat" volontairement (pas de ${VAR} imbriquées) : compatible Portainer.
# Les mots de passe doivent rester alphanumériques (ils sont insérés dans des URL).

APPFLOWY_DATA_DIR=/volume2/docker/appflowy

FQDN=appflowy.jo.priv
APPFLOWY_BASE_URL=https://appflowy.jo.priv
APPFLOWY_WEB_URL=https://appflowy.jo.priv
APPFLOWY_WEBSOCKET_BASE_URL=wss://appflowy.jo.priv/ws/v2
API_EXTERNAL_URL=https://appflowy.jo.priv/gotrue

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=postgres
APPFLOWY_DATABASE_URL=postgres://postgres:CHANGE_ME_POSTGRES@postgres:5432/postgres
GOTRUE_DATABASE_URL=postgres://postgres:CHANGE_ME_POSTGRES@postgres:5432/postgres?search_path=auth
APPFLOWY_REDIS_URI=redis://redis:6379

GOTRUE_ADMIN_EMAIL=admin@jo.priv
GOTRUE_ADMIN_PASSWORD=CHANGE_ME_ADMIN
GOTRUE_JWT_SECRET=CHANGE_ME_64_CARACTERES_ALEATOIRES
GOTRUE_JWT_EXP=604800
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=false

APPFLOWY_S3_ACCESS_KEY=CHANGE_ME_S3_KEY
APPFLOWY_S3_SECRET_KEY=CHANGE_ME_S3_SECRET
APPFLOWY_S3_BUCKET=appflowy
APPFLOWY_S3_CREATE_BUCKET=true
APPFLOWY_S3_PRESIGNED_URL_ENDPOINT=https://appflowy.jo.priv/minio-api

# SMTP (optionnel)
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=465
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=
APPFLOWY_MAILER_SMTP_HOST=
APPFLOWY_MAILER_SMTP_PORT=465
APPFLOWY_MAILER_SMTP_USERNAME=
APPFLOWY_MAILER_SMTP_EMAIL=
APPFLOWY_MAILER_SMTP_PASSWORD=
APPFLOWY_MAILER_SMTP_TLS_KIND=wrapper

# IA (optionnel)
AI_OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
ASSEMBLYAI_API_KEY=

RUST_LOG=info
